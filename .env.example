# ============================================================
#  INSIDA — переменные окружения
#  Скопируйте этот файл в .env и заполните своими значениями.
#  Файл .env НИКОГДА не публикуйте и не отправляйте в git.
# ============================================================

# База данных PostgreSQL.
# Локально:  postgres://insida:insida@localhost:5432/insida
# Neon:      строка подключения из панели Neon (вариант «Pooled»), с ?sslmode=require в конце
DATABASE_URL=postgres://insida:insida@localhost:5432/insida

# Отдельная база для автоматических тестов (её содержимое стирается при каждом запуске тестов!)
TEST_DATABASE_URL=postgres://insida:insida@localhost:5432/insida_test

# Публичный адрес сайта без слэша в конце — для SEO, sitemap, Open Graph.
# Локально http://localhost:3000; на Netlify — https://ВАШ-САЙТ.netlify.app
SITE_URL=http://localhost:3000

# Секрет для хеширования служебных значений (минимум 32 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Сколько прокси стоит перед приложением (для ограничения попыток входа по IP).
# 0 — локально; на Netlify и за nginx — 1.
TRUSTED_PROXY_COUNT=0

# Размер пула подключений к базе. На бесплатном Neon и Netlify — 3.
DB_POOL_MAX=5
